FROM python:3.13-slim@sha256:2d44738ebf4ce5f63b9d9ea871e9c7cfdc0426f7b0c97cac915fd88ded1d86bb
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Feste Versionen mit Hashes (requirements.lock aus requirements.in, siehe dort).
COPY requirements.lock requirements-gpu.lock /tmp/
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
# Auf der Grafikkarte (compose/gpu-sprache.yml, GPU=1): cuBLAS und cuDNN 9 fuer CTranslate2,
# als Python-Pakete von NVIDIA (~1,5 GB). Ohne GPU=1 bleibt das Image so klein wie bisher.
ARG GPU=0
RUN if [ "$GPU" = "1" ]; then \
        pip install --no-cache-dir --require-hashes -r /tmp/requirements-gpu.lock; \
    fi \
    && rm /tmp/requirements.lock /tmp/requirements-gpu.lock
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.13/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.13/site-packages/nvidia/cudnn/lib
COPY app.py /app/app.py
RUN useradd -m -u 1000 sttuser && mkdir -p /home/sttuser/.cache/huggingface && chown -R sttuser:sttuser /app /home/sttuser
USER sttuser
ENV WHISPER_MODEL=large-v3-turbo \
    WHISPER_COMPUTE_TYPE=int8 \
    WHISPER_LANGUAGE=de \
    HF_HOME=/home/sttuser/.cache/huggingface
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8003", "--workers", "1"]
