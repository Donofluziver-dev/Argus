# Argus: Vorlage fuer die .env der Installation.
#
# "python setup/init_stack.py" erzeugt daraus die .env und legt die Geheimnisse an
# (API_Tokens/, SEARXNG_SECRET, CANARY_TOKENS). Danach die Werte unter
# "Installation" und "Modell" pruefen. Die .env selbst kommt nie ins Repo.
#
# Hier steht nur, was vom Standard im Code abweicht oder je Rechner verschieden
# ist. Jeder andere Schalter des Backends laesst sich zusaetzlich setzen; ohne
# Eintrag gilt der Standard aus dem Code.

# --- Installation ------------------------------------------------------------
# Modelle (GGUF) und Arbeitsordner liegen ausserhalb des Repos.
ARGUS_MODELS_DIR=C:/Argus_Models
ARGUS_WORKSPACE_DIR=C:/Argus_Workspace
ARGUS_EVALS_DIR=C:/Argus_Workspace/Evals

# --- Sprache und Region ------------------------------------------------------
# Zusaetzliche Anweisung an das Modell, leer = keine.
SYSTEM_PROMPT=
# Sprache der Websuche.
SEARXNG_LANGUAGE=de-DE
# OpenStreetMap verlangt eine Kennung mit Kontakt, z. B. "Argus/1.0 (name@example.org)".
GEOCODER_USER_AGENT=Argus/1.0 (self-hosted assistant)
# Eigene Stimme fuer die Sprachausgabe (optional, siehe voice_ref/README.md).
QWEN_CLONE_REF_TEXT=
QWEN_CLONE_REF_SPK=
QWEN_CLONE_REF_RVQ=
QWEN_SEED=

# --- Datenbank ---------------------------------------------------------------
# Das Passwort steht nicht hier, sondern in API_Tokens/postgres_password.txt.
POSTGRES_USER=argus_user
POSTGRES_DB=ragdb
DATABASE_URL=postgresql+psycopg2://argus_user@postgres:5432/ragdb

# --- Modell (passend zur Grafikkarte einstellen) -----------------------------
# Gemessen auf RTX 5070 Ti 16 GB mit DDR5: ~79 Token/s, ~14,9 GB VRAM.
# LLM_N_CPU_MOE = Schichten, deren Experten im RAM liegen. Weniger VRAM -> hoeher.
OAI_MODEL=qwen3.6-35b-a3b
OAI_BASE_URL=http://llm:8080/v1
LLM_MODEL_FILE=Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf
LLM_N_CPU_MOE=25
LLM_CTX_SIZE=102400
LLM_PARALLEL=2
LLM_CTX_PER_SLOT=72000
LLM_CACHE_TYPE=f16
LLM_BATCH=2048
LLM_UBATCH=512
LLM_THREADS=8
LLM_MTP=true
LLM_MTP_DRAFT=3
# Das Backend liest die Kontextgroesse je Platz selbst aus llama.cpp (/props).
# Nur bei Bedarf kleiner deckeln: LLM_CONTEXT_LIMIT=<Token>.

# --- Geheimnisse (erzeugt setup/init_stack.py, nie von Hand ausdenken) -------
# HMAC-Schluessel fuer SearXNG: 64 Hex-Zeichen.
SEARXNG_SECRET=
# Koeder-Schluessel, Komma-getrennt, je ab 12 Zeichen. Leer = aus.
CANARY_TOKENS=

# --- Dienste -----------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006
# Adressen, unter denen die Browser-Oberflaeche aufgerufen wird. Auf einem Server
# hinter einem Reverse-Proxy dessen Adresse eintragen (https://argus.example.org)
# und den Namen bei TRUSTED_HOSTS ergaenzen; "rag-backend" und "localhost" bleiben.
DASHBOARD_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
TRUSTED_HOSTS=127.0.0.1,localhost,rag-backend
# Adresse, unter der der BROWSER die Ablaufverfolgung (Phoenix) erreicht. Sie wird
# im Monitor eingebettet. Leer = der Reiter zeigt nur einen Hinweis.
DASHBOARD_TRACES_URL=http://127.0.0.1:6006

# --- Sicherheit (Bedeutung siehe README, Abschnitt Sicherheit) -----------------
WEB_INJECTION_GUARD=true
# Nach dem Lesen von Firmendaten: block = kein Weg nach aussen mehr in diesem
# Gespraech, allow = offen, nur Anfragen mit gelesenen Bestandteilen werden gesperrt.
EGRESS_AFTER_SENSITIVE=block
# Phoenix-Traces: redacted (Schluessel/PII geschwaerzt) oder metadata (nur Ablauf).
TRACE_CONTENT=redacted
DASHBOARD_ALLOW_REGISTER=false
# Einrichtungs-Schluessel: Nur wer ihn kennt, legt im Browser das erste
# Administrator-Konto an. setup/init_stack.py erzeugt ihn. Leer = jeder, der die
# Seite zuerst erreicht, wird Administrator.
DASHBOARD_SETUP_TOKEN=

# --- Cloud-Helfer (Gemini, optional) -------------------------------------------
# Ohne Schluessel in API_Tokens/Gemini.txt aus lassen.
CLOUD_AGENTS_ENABLED=false
# true = Cloud-Missionen und cloud_ask gehen ohne Rueckfrage raus (Schwaerzung bleibt).
CLOUD_MISSION_AUTO_APPROVE=false
CLOUD_MISSION_PLANNER=local
CLOUD_GEMINI_MODEL=gemini-3.7-flash
CLOUD_MISSION_PLANNER_MODEL=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
CLOUD_WORKER_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
CLOUD_COLLAB_ARCHITECT_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
CLOUD_COLLAB_RESEARCH_MODEL=gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
CLOUD_RESEARCH_SOURCES=8
CLOUD_RESEARCH_PER_SOURCE_CHARS=4000
CLOUD_CALL_MAX_OUTPUT_TOKENS=4096
CLOUD_PAYLOAD_MAX_CHARS=40000
CODING_MAX_ITERATIONS=8
