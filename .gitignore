# Argus: Backend, Browser-Oberflaeche und Container-Stapel. Der Code hier ist die Quelle.

# --- GEHEIM: darf das Geraet nie verlassen ---
API_Tokens/
.env
.env.*
!.env.example
*.pem
*.ppk
id_ed25519
id_rsa
# Stimmaufnahmen (biometrisch), nur die Anleitung ist oeffentlich.
voice_ref/*
!voice_ref/README.md

# --- Laufzeit ---
.venv-setup/
__pycache__/
*.pyc
.pytest_cache/
documents_to_ingest/*
!documents_to_ingest/.gitkeep
proxy/certs/*
!proxy/certs/.gitkeep
proxy/data/
# Offline-Paket: gebaute Pakete und die beim Laden erzeugte Compose-Ergaenzung.
argus-bundle-*/
docker-compose.bundle.yml
*.log

rag_backend/tests/.account_crypto_test.json
